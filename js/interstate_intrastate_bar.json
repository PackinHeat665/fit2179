{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 430,
  "data": {"url": "data/tourism/state_summary_2024.csv"},
  "transform": [
    {"filter": "datum.state != 'Australia'"},
    {"fold": ["interstate_trips_000", "intrastate_trips_000"], "as": ["travel_type_raw", "trips"]},
    {"calculate": "datum.travel_type_raw == 'interstate_trips_000' ? 'Interstate' : 'Intrastate'", "as": "travel_type"},
    {"aggregate": [{"op": "sum", "field": "trips", "as": "total_trips"}], "groupby": ["travel_type"]},
    {"joinaggregate": [{"op": "sum", "field": "total_trips", "as": "overall_trips"}]},
    {"calculate": "datum.total_trips / datum.overall_trips", "as": "share"}
  ],
  "layer": [
    {
      "mark": {"type": "arc", "innerRadius": 95, "outerRadius": 150, "tooltip": true},
      "encoding": {
        "theta": {"field": "total_trips", "type": "quantitative"},
        "color": {
          "field": "travel_type",
          "type": "nominal",
          "title": "Travel type",
          "scale": {"domain": ["Interstate", "Intrastate"], "range": ["#4C78A8", "#F58518"]},
          "legend": {
            "orient": "none",
            "legendX": 180,
            "legendY": 405,
            "direction": "horizontal",
            "columns": 2,
            "titleAnchor": "middle",
            "labelFontSize": 12,
            "titleFontSize": 13
          }
        },
        "tooltip": [
          {"field": "travel_type", "title": "Travel type"},
          {"field": "total_trips", "title": "Overnight trips (in thousands)", "format": ",.0f"},
          {"field": "share", "title": "Share of trips", "format": ".1%"}
        ]
      }
    },
    {
      "data": {"values": [{}]},
      "mark": {
        "type": "text",
        "text": "Total overnight trips",
        "align": "center",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": "bold",
        "fill": "#174955",
        "y": 190
      }
    },
    {
      "transform": [
        {"aggregate": [{"op": "max", "field": "overall_trips", "as": "total"}]},
        {"calculate": "format(datum.total, ',.0f')", "as": "label"}
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 20,
        "fontWeight": "bold",
        "fill": "#174955",
        "y": 220
      },
      "encoding": {
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "legend": {"labelFontSize": 12, "titleFontSize": 13}
  }
}
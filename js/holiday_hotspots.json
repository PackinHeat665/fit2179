{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 430,
  "height": 420,
  "data": {"url": "data/destinations/top_holiday_lgas.csv"},
  "transform": [
    {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "tot_rsn_vis_000_holiday", "order": "descending"}]},
    {"filter": "datum.rank <= 15"}
  ],
  "layer": [
    {
      "mark": {"type": "bar", "height": 2},
      "encoding": {
        "y": {"field": "lga_name18", "type": "nominal", "sort": "-x", "title": "Local government area"},
        "x": {"field": "tot_rsn_vis_000_holiday", "type": "quantitative", "title": "Holiday visitors (in thousands)"},
        "color": {"field": "tot_rsn_vis_000_holiday", "type": "quantitative", "legend": null, "scale": {"scheme": "viridis"}},
        "tooltip": [
          {"field": "lga_name18", "title": "Destination"},
          {"field": "state", "title": "State"},
          {"field": "tot_rsn_vis_000_holiday", "title": "Holiday visitors (in thousands)", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {"type": "circle", "size": 140, "tooltip": true, "stroke": "black", "strokeWidth": 0.5},
      "encoding": {
        "y": {"field": "lga_name18", "type": "nominal", "sort": "-x", "title": "Local government area"},
        "x": {"field": "tot_rsn_vis_000_holiday", "type": "quantitative", "title": "Holiday visitors (in thousands)"},
        "color": {"field": "tot_rsn_vis_000_holiday", "type": "quantitative", "legend": null, "scale": {"scheme": "viridis"}},
        "tooltip": [
          {"field": "lga_name18", "title": "Destination"},
          {"field": "state", "title": "State"},
          {"field": "tot_rsn_vis_000_holiday", "title": "Holiday visitors (in thousands)", "format": ",.0f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.rank == 1"}],
      "mark": {"type": "text", "align": "right", "baseline": "middle", "fontSize": 12, "fontWeight": "bold", "fill": "#5c3b10", "dx": -10, "dy": -12},
      "encoding": {
        "x": {"field": "tot_rsn_vis_000_holiday", "type": "quantitative"},
        "y": {"field": "lga_name18", "type": "nominal", "sort": "-x"},
        "text": {"value": "Top holiday LGA"}
      }
    }
  ],
  "config": {
    "axis": {"labelFontSize": 11, "titleFontSize": 12},
    "title": {"fontSize": 16, "anchor": "start"},
    "view": {"stroke": null}
  }
}
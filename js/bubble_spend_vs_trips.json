{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Tourism spending compared with trip volume by state, 2024",
  "width": 760,
  "height": 400,
  "data": {"url": "data/tourism/state_summary_2024.csv"},
  "mark": {"type": "circle", "tooltip": true, "size": 260, "opacity": 0.85, "stroke": "black", "strokeWidth": 0.8},
  "encoding": {
    "x": {"field": "total_trips_000", "type": "quantitative", "title": "Total trips (in thousands)"},
    "y": {"field": "total_spend_millions", "type": "quantitative", "title": "Total spending (AUD millions)"},
    "color": {"field": "state_abbrev", "type": "nominal", "title": "State"},
    "tooltip": [
      {"field": "state", "title": "State"},
      {"field": "total_trips_000", "title": "Total trips (in thousands)", "format": ",.0f"},
      {"field": "total_spend_millions", "title": "Total spending (AUD millions)", "format": ",.0f"},
      {"field": "avg_overnight_nights_per_trip", "title": "Average nights per trip", "format": ".2f"}
    ]
  },
  "config": {
    "axis": {"labelFontSize": 12, "titleFontSize": 13},
    "title": {"fontSize": 16, "anchor": "start"},
    "legend": {"orient": "right"}
  }
}
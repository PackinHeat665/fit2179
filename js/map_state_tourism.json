{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 900,
  "height": 660,
  "params": [
    {
      "name": "metric",
      "value": "trips",
      "bind": {
        "input": "select",
        "name": "Colour map by: ",
        "options": ["trips", "spending"],
        "labels": ["Total trips", "Total spending"]
      }
    }
  ],
  "data": {"url": "data/maps/australia_states.geojson", "format": {"type": "json", "property": "features"}},
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {"url": "data/tourism/state_summary_2024.csv"},
        "key": "state",
        "fields": ["total_trips_000", "total_spend_millions", "state_abbrev"]
      }
    }
  ],
  "projection": {"type": "mercator", "center": [134, -27.5], "scale": 710, "translate": [450, 250]},
  "layer": [
    {
      "transform": [{"filter": "metric == 'trips'"}],
      "mark": {"type": "geoshape", "stroke": "black", "strokeWidth": 1.4, "tooltip": true},
      "encoding": {
        "color": {
          "field": "total_trips_000",
          "type": "quantitative",
          "title": "Trips (in thousands)",
          "scale": {"scheme": "blues", "domain": [0, 120000]},
          "legend": {
            "orient": "none",
            "legendX": 70,
            "legendY": 530,
            "direction": "horizontal",
            "titleLimit": 200,
            "tickCount": 4,
            "format": ",.0f",
            "gradientLength": 310
          }
        },
        "tooltip": [
          {"field": "properties.STATE_NAME", "title": "State"},
          {"field": "state_abbrev", "title": "State abbreviation"},
          {"field": "total_trips_000", "title": "Trips (in thousands)", "format": ",.0f"},
          {"field": "total_spend_millions", "title": "Spending (AUD millions)", "format": ",.0f"}
        ]
      }
    },
    {
      "transform": [{"filter": "metric == 'spending'"}],
      "mark": {"type": "geoshape", "stroke": "black", "strokeWidth": 1.4, "tooltip": true},
      "encoding": {
        "color": {
          "field": "total_spend_millions",
          "type": "quantitative",
          "title": "Spending (AUD millions)",
          "scale": {"scheme": "greens", "domain": [0, 60000]},
          "legend": {
            "orient": "none",
            "legendX": 520,
            "legendY": 530,
            "direction": "horizontal",
            "titleLimit": 200,
            "tickCount": 4,
            "format": ",.0f",
            "gradientLength": 310
          }
        },
        "tooltip": [
          {"field": "properties.STATE_NAME", "title": "State"},
          {"field": "state_abbrev", "title": "State abbreviation"},
          {"field": "total_trips_000", "title": "Trips (in thousands)", "format": ",.0f"},
          {"field": "total_spend_millions", "title": "Spending (AUD millions)", "format": ",.0f"}
        ]
      }
    },
    {
      "data": {"values": [{}]},
      "mark": {
        "type": "text",
        "x": 610,
        "y": 210,
        "text": "Eastern states show\nstrongest tourism activity",
        "align": "left",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": "bold",
        "fill": "#174955"
      }
    }
  ],
  "resolve": {"scale": {"color": "independent"}},
  "config": {
    "view": {"stroke": null},
    "legend": {"labelFontSize": 11, "titleFontSize": 12}
  }
}